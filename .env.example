# ===================================================
# MIDDLEMAN - CLOUD FLEET CONTROLLER CONFIGURATION
# ===================================================

# 1. MongoDB Database (Required)
# Free M0 cluster from MongoDB Atlas: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/megaserver?retryWrites=true&w=majority

# 2. GitHub Automation Token (Required for repo creation & code push)
# Generate from GitHub -> Settings -> Developer Settings -> Personal Access Tokens (Classic)
# Required scopes: repo, workflow, admin:repo_hook
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# 3. Security & Cryptographic Vault (Required)
# 32+ character random secret string used for AES-256-GCM encryption of all DB secrets
ENCRYPTION_MASTER_KEY=super-secret-vault-master-key-32chars-minimum!

# 4. Asynchronous JIT Worker Secret
# Shared secret between Middleman and Railway Playwright Account Worker
WEBHOOK_SECRET=mega-server-jit-worker-secret-2026

# 5. Admin Dashboard Passkey (Required)
# Password to lock the Middleman Admin Panel on Vercel
ADMIN_PASSKEY=admin@megaserver#2026

# 6. Telegram Master Alerts (Optional)
# Receives real-time push alerts on JIT account creations and auto-migrations
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# 7. Mailu.site Temporary Mail and OTP Automation
MAILU_API_KEY=ml_live_YOUR_KEY_HERE
MAILU_DOMAIN=mailu.site
